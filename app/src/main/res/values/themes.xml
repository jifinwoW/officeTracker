<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OfficeTimeTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand -->
        <item name="colorPrimary">@color/primary_800</item>
        <item name="colorPrimaryVariant">@color/primary_900</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Accent -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background / Surfaces -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_main</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/primary_900</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
