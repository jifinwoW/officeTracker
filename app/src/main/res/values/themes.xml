<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OfficeTimeTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary Brand -->
        <item name="colorPrimary">@color/deep_navy</item>
        <item name="colorPrimaryVariant">@color/darker_navy</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Accent -->
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorSecondaryVariant">@color/rich_gold</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background / Surfaces -->
        <item name="android:colorBackground">@color/light_gray_bg</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/darker_navy</item>
        <item name="android:navigationBarColor">@color/darker_navy</item>
    </style>
</resources>
